# InsForge project — public API base URL
NEXT_PUBLIC_INSFORGE_URL=https://<project-ref>.insforge.app

# InsForge anon key — safe to expose, row access is decided by RLS
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only InsForge config
INSFORGE_URL=https://<project-ref>.insforge.app
INSFORGE_ANON_KEY=

# Server-only admin key — NEVER prefix with NEXT_PUBLIC_, never commit
INSFORGE_API_KEY=

# Used for canonical URLs / metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public store name, used in titles / OG / schema.org (fallback: "Q2M")
NEXT_PUBLIC_STORE_NAME=Q2M
NEXT_PUBLIC_STORE_NAME_LONG=QUE DE LA MARQUE TUNIS

# Meta Pixel ID (Facebook/Instagram). Leave empty to disable tracking.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional Gemini access (description generation, AI helpers)
GEMINI_API_KEY=
GEMINI_MODEL=